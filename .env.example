# HMAC key for stored codes. Unset -> random per start (secrets.token_bytes(32)).
# OTP_SECRET=
# Or a key file, created on first start (Docker Compose uses a volume).
# OTP_SECRET_FILE=

# Bonus: Redis storage via Docker Compose. Unset -> in-memory.
# REDIS_URL=redis://localhost:6379/0

# SMS delivery stub: JSON lines {"ts","msisdn","code"}. Default: <repo root>/outbox/sms.jsonl.
# OTP_OUTBOX=
